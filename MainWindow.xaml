<Window x:Class="SeeFit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SeeFit — FITS Image Viewer"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800"
        Background="#1E1E1E">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static NavigationCommands.IncreaseZoom}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static NavigationCommands.IncreaseZoom}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static NavigationCommands.DecreaseZoom}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static NavigationCommands.DecreaseZoom}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static NavigationCommands.Zoom}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static NavigationCommands.Zoom}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OpenFits_Executed"/>
        <CommandBinding Command="{x:Static NavigationCommands.IncreaseZoom}" Executed="ZoomIn_Executed"/>
        <CommandBinding Command="{x:Static NavigationCommands.DecreaseZoom}" Executed="ZoomOut_Executed"/>
        <CommandBinding Command="{x:Static NavigationCommands.Zoom}" Executed="ZoomFit_Executed"/>
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#D3D3D3" Foreground="Black">
            <MenuItem Header="_File">
                <MenuItem Header="_Open FITS…" Click="OpenFits_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Click="ZoomIn_Click" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom _Out" Click="ZoomOut_Click" InputGestureText="Ctrl+-"/>
                <MenuItem Header="_Fit to Window" Click="ZoomFit_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="_Actual Size (100%)" Click="ZoomActual_Click" InputGestureText="Ctrl+1"/>
                <Separator/>
                <MenuItem x:Name="DebayerMenuItem"
                          Header="_Debayer Color Image"
                          IsCheckable="True"
                          Click="Debayer_Click"/>
                <MenuItem x:Name="ScnrMenuItem"
                          Header="_SCNR (Chrominance Noise Reduction)"
                          IsCheckable="True"
                          Click="Scnr_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Open a FITS file to begin."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="Zoom: —"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top" Background="#E8E8E8">
            <ToolBar Background="#E8E8E8">
                <Button Content="Open" Padding="10,4" Margin="2" Click="OpenFits_Click"
                        ToolTip="Open a FITS file"/>
                <Separator/>
                <Button Content="Zoom In" Padding="10,4" Margin="2" Click="ZoomIn_Click"
                        ToolTip="Zoom in"/>
                <Button Content="Zoom Out" Padding="10,4" Margin="2" Click="ZoomOut_Click"
                        ToolTip="Zoom out"/>
                <Button Content="Fit" Padding="10,4" Margin="2" Click="ZoomFit_Click"
                        ToolTip="Fit image to window"/>
                <Button Content="100%" Padding="10,4" Margin="2" Click="ZoomActual_Click"
                        ToolTip="Show at actual size"/>
                <Separator/>
                <CheckBox x:Name="DebayerCheckBox"
                          Content="Debayer"
                          Margin="8,0,4,0"
                          VerticalAlignment="Center"
                          ToolTip="Convert Bayer CFA mosaic to color"
                          Checked="Debayer_Changed"
                          Unchecked="Debayer_Changed"/>
                <TextBlock Text="Pattern:"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="BayerPatternCombo"
                          Width="90"
                          Margin="0,2"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          ToolTip="Bayer mosaic pattern (Auto uses BAYERPAT from the FITS header)"
                          SelectionChanged="BayerPatternCombo_SelectionChanged">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="RGGB"/>
                    <ComboBoxItem Content="BGGR"/>
                    <ComboBoxItem Content="GRBG"/>
                    <ComboBoxItem Content="GBRG"/>
                </ComboBox>
            </ToolBar>
            <ToolBar Background="#E8E8E8" Band="1">
                <CheckBox x:Name="ScnrCheckBox"
                          Content="SCNR"
                          Margin="8,0,4,0"
                          VerticalAlignment="Center"
                          ToolTip="Subtractive Chromatic Noise Reduction (requires Debayer)"
                          Checked="Scnr_Changed"
                          Unchecked="Scnr_Changed"/>
                <TextBlock Text="Color:"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="ScnrColorCombo"
                          Width="70"
                          Margin="0,2"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          ToolTip="Channel to reduce"
                          SelectionChanged="ScnrSettings_Changed">
                    <ComboBoxItem Content="Green"/>
                    <ComboBoxItem Content="Red"/>
                    <ComboBoxItem Content="Blue"/>
                </ComboBox>
                <TextBlock Text="Method:"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="ScnrMethodCombo"
                          Width="130"
                          Margin="0,2"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          ToolTip="SCNR protection method"
                          SelectionChanged="ScnrSettings_Changed">
                    <ComboBoxItem Content="Average Neutral"/>
                    <ComboBoxItem Content="Maximum Neutral"/>
                    <ComboBoxItem Content="Minimum Neutral"/>
                    <ComboBoxItem Content="Maximum Mask"/>
                    <ComboBoxItem Content="Additive Mask"/>
                </ComboBox>
                <TextBlock Text="Amount:"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"/>
                <Slider x:Name="ScnrAmountSlider"
                        Width="120"
                        Minimum="0"
                        Maximum="1"
                        Value="1"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ToolTip="SCNR strength"
                        ValueChanged="ScnrAmount_ValueChanged"/>
                <TextBlock x:Name="ScnrAmountText"
                           Text="100%"
                           Width="36"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="ScnrPreserveLightnessCheckBox"
                          Content="Preserve lightness"
                          Margin="12,0,4,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          ToolTip="Keep pixel brightness after SCNR"
                          Checked="Scnr_Changed"
                          Unchecked="Scnr_Changed"/>
            </ToolBar>
        </ToolBarTray>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    Background="#111111"
                    CornerRadius="2">
                <Grid>
                    <TextBlock x:Name="PlaceholderText"
                               Text="No image loaded"
                               Foreground="#888888"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <ScrollViewer x:Name="ImageScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                                  PreviewMouseLeftButtonDown="ImageScrollViewer_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="ImageScrollViewer_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="ImageScrollViewer_LostMouseCapture">
                        <Image x:Name="FitsImageControl"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderTransformOrigin="0,0">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#3F3F46"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="FITS Keywords"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,8"/>
                <DataGrid x:Name="KeywordsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#2A2A2E"
                          Background="#1E1E1E"
                          Foreground="White"
                          BorderBrush="#3F3F46"
                          RowBackground="#1E1E1E">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Keyword"
                                            Binding="{Binding Keyword}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Comment"
                                            Binding="{Binding Comment}"
                                            Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
